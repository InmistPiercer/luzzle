{
  "name": "luzzle",
  "productName": "Luzzle",
  "private": true,
  "version": "6.15.0",
  "description": "Luzzle · 语境词汇拼图",
  "author": "Luzzle",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "build": "tsc -b && vite build",
    "build:test": "tsc -b && vite build --mode test",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:test": "vite preview --mode test",
    "electron:dev": "node electron/dev.mjs",
    "electron:dev:test": "node electron/dev.mjs --test",
    "electron:start": "npm run build && electron .",
    "electron:mac": "npm run build && electron-builder --config electron-builder.json --mac dmg",
    "electron:mac:all": "npm run build && electron-builder --config electron-builder.json --mac dmg zip --arm64 --x64",
    "electron:win": "npm run build && electron-builder --config electron-builder.json --win nsis portable --x64",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "e2e": "node e2e/flows.mjs",
    "dict": "node scripts/build-dict.mjs raw/ecdict.csv public/dict",
    "pdf-test": "node scripts/pdf-ai-test.mjs ..",
    "morph": "python3 scripts/build-morph.py",
    "examples": "python3 scripts/build-examples.py",
    "senses": "python3 scripts/build-senses.py",
    "raw": "sh scripts/fetch-raw.sh"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^5.4.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.8",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
